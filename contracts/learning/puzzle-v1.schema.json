{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlchess.dev/contracts/learning/puzzle-v1.schema.json",
  "title": "PuzzleV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "fen", "difficulty", "tags", "source_name", "source_url", "license"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "minLength": 1, "maxLength": 160},
    "fen": {"type": "string", "minLength": 1, "maxLength": 120}, "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
    "tags": {"type": "array", "items": {"type": "string", "maxLength": 80}, "maxItems": 16},
    "source_name": {"type": "string", "maxLength": 200}, "source_url": {"type": "string", "format": "uri", "pattern": "^https://"}, "license": {"type": "string", "maxLength": 120}
  }
}
