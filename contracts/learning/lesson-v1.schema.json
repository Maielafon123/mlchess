{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlchess.dev/contracts/learning/lesson-v1.schema.json",
  "title": "LessonV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "summary", "body", "language", "status", "source_name", "source_url", "license", "tags"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200}, "summary": {"type": "string", "maxLength": 500},
    "body": {"type": "string", "maxLength": 10000}, "language": {"type": "string", "enum": ["ru", "en"]},
    "status": {"type": "string", "enum": ["not-started", "started", "completed"]},
    "source_name": {"type": "string", "maxLength": 200}, "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "license": {"type": "string", "maxLength": 120}, "tags": {"type": "array", "items": {"type": "string", "maxLength": 80}, "maxItems": 16}
  }
}
