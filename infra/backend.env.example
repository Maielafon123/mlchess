# Development only. No credentials are required by the health-only scaffold.
MLCHESS_ENVIRONMENT=development
MLCHESS_PUBLIC_ORIGIN=http://127.0.0.1:8000
MLCHESS_DEV_AUTH_ENABLED=false
MLCHESS_READINESS_TIMEOUT_MS=500
# Staging/production must use the public HTTPS origin and DEV_AUTH_ENABLED=false.
# Durable APIs require a migrated database. This password is for local Compose only.
MLCHESS_DATABASE_URL=postgresql+asyncpg://mlchess:mlchess_dev@127.0.0.1:55432/mlchess
MLCHESS_DATABASE_AUTO_CREATE=false
