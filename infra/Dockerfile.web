FROM node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS dev
RUN npm install --global pnpm@11.25.0
WORKDIR /workspace/apps/web
COPY apps/web/package.json apps/web/pnpm-lock.yaml apps/web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/web/ ./
COPY contracts/generated/ /workspace/contracts/generated/
USER node
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "5173"]

FROM dev AS build
RUN pnpm build

FROM caddy:2-alpine@sha256:78bd35025c7ba85961dd149ae670315129954e77abe2383ac47c89106b35ade9 AS static
COPY --from=build /workspace/apps/web/dist/ /srv/
COPY infra/Caddyfile.static /etc/caddy/Caddyfile
USER 10001:10001
