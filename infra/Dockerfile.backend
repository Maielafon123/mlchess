FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS api
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY backend/ backend/
COPY contracts/coach/ contracts/coach/
RUN pip install --constraint backend/requirements.lock ./backend
COPY infra/container_probe.py infra/
USER 10001:10001
CMD ["uvicorn", "backend.app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers", "--no-access-log", "--log-level", "warning", "--ws", "websockets", "--ws-max-size", "2048", "--ws-max-queue", "4", "--ws-per-message-deflate", "false"]

FROM api AS worker
USER root
RUN apt-get update && apt-get install -y --no-install-recommends stockfish=15.1-4 \
    && echo 'af67e5f96d92cf6a730f89291ea439ba90ca5bf7921e5d740d79ccfc4584bc92  /usr/games/stockfish' | sha256sum -c - \
    && rm -rf /var/lib/apt/lists/*
RUN python -m backend.app.engine.manifest --binary /usr/games/stockfish --write /app/stockfish-manifest.json \
    && chmod 444 /app/stockfish-manifest.json
ENV MLCHESS_STOCKFISH_BINARY=/usr/games/stockfish MLCHESS_STOCKFISH_SHA256=af67e5f96d92cf6a730f89291ea439ba90ca5bf7921e5d740d79ccfc4584bc92
ENV MLCHESS_STOCKFISH_MANIFEST=/app/stockfish-manifest.json
USER 10001:10001
CMD ["python", "-m", "backend.app.workers.runner"]
